{
  "name": "zelos-desktop",
  "productName": "Zelos",
  "version": "1.8.1",
  "description": "The Electron shell for Zelos \u2014 a local-first second brain. The core it runs is dependency-free; Electron lives only in this package.",
  "author": {
    "name": "Zelos"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "updates": {
    "publicKeys": [],
    "windowsPublisher": ""
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.zelos.desktop",
    "productName": "Zelos",
    "copyright": "MIT licensed. Local-first: reading and AI use the services you configure; update checks are manual.",
    "asar": false,
    "npmRebuild": false,
    "forceCodeSigning": false,
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "*.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../core",
        "to": "core",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../ui",
        "to": "ui",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../docs",
        "to": "docs",
        "filter": [
          "*.md"
        ]
      },
      {
        "from": "../package.json",
        "to": "package.json"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "../assets/icon.png",
      "darkModeSupport": true,
      "notarize": false,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSApplicationCategoryType": "public.app-category.productivity",
        "NSHumanReadableCopyright": "MIT licensed."
      },
      "identity": "-"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 390,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "../assets/icon.png",
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zelos",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
