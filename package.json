{
  "name": "zelos-app",
  "version": "1.8.1",
  "description": "A local-first second brain. Reads your mail and calendar, thinks with a model you choose, and gives you one page worth looking at.",
  "type": "module",
  "bin": {
    "zelos": "./zelos.mjs"
  },
  "main": "./core/server.mjs",
  "files": [
    "core/",
    "ui/",
    "assets/",
    "!assets/icon.png",
    "docs/*.md",
    "zelos.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16.0 <23 || >=24"
  },
  "homepage": "https://zelos-app.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoosAI-Platform/zelos.git"
  },
  "bugs": {
    "url": "https://github.com/HoosAI-Platform/zelos/issues"
  },
  "scripts": {
    "start": "node zelos.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/*.test.mjs\""
  },
  "keywords": [
    "second-brain",
    "local-first",
    "imap",
    "calendar",
    "llm",
    "ollama",
    "privacy",
    "mcp"
  ],
  "license": "MIT",
  "private": false
}
